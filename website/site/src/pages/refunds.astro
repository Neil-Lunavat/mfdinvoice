---
import Layout from '../layouts/Layout.astro';
import Legal, { type Section } from '../components/Legal.astro';
import '../styles/base.css';
import '../styles/kit.css';
import { NAME, TRIAL, EMAIL } from '../consts';
import { companyLine } from '../lib/format';

const sections: Section[] = [
  { h: 'Try it first', p: [
    `Every ARN gets a free trial of ${TRIAL.days} days. It starts when you add your ARN in the app, and it asks for no payment. Use it to see a real month through before you pay.`,
  ] },
  { h: 'No refunds', p: [
    'A plan is paid for a year in advance, and we don’t refund it, in whole or in part. That holds if you stop using the app, if you delete your account, or if your plan has months left.',
    'Nothing renews by itself. When your year ends, the app stops until you buy again, so you are never charged without choosing to pay.',
  ] },
  { h: 'When we return a payment', p: [
    'Two cases are mistakes, not refunds, and we return the money:',
    '<ul><li>You paid twice for the same plan. We return the extra payment.</li><li>You paid and your plan never started. We return that payment.</li></ul>',
  ] },
  { h: 'How to ask', p: [
    `Write to us on the <a href="/support?about=payment">Support page</a> and choose “A payment I made”, with the payment’s reference (it starts with MFD) and its UTR number. You can also write to <a href="mailto:${EMAIL.support}">${EMAIL.support}</a>.`,
  ] },
  { h: 'How long it takes', p: [
    'We reply within 2 working days. Once we agree a payment is due back, it reaches the account it came from within 7 working days.',
  ] },
  { h: 'Contact', p: [
    companyLine(),
    `To ask about a payment, write to <a href="mailto:${EMAIL.support}">${EMAIL.support}</a>. The rest of the rules for your plan are in the <a href="/terms">Terms</a>.`,
  ] },
];
---
<Layout title={`Refund policy · ${NAME}`} description={`A ${TRIAL.days}-day free trial first. No refunds once you’ve paid, except a payment made twice or a plan that never started.`} path="/refunds">
  <Legal title="Refund policy" sections={sections} />
</Layout>
