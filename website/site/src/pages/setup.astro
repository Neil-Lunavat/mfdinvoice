---
/* Setting the software up, step by step, in the order the software asks (client/window/src/logic/details.ts STEP_TITLES).
   Words only for now: the pictures and the videos come once the software's screens stop changing. */
import Layout from '../layouts/Layout.astro';
import '../styles/kit.css';
import { NAME, TRIAL } from '../consts';

const STEPS: { h: string; p: string[] }[] = [
  { h: 'Download and install', p: [
    `Get the installer from <a class="tlink" href="/downloads">Downloads</a> and open it. It installs for you alone and asks for no administrator password.`,
    `Windows may show <b>“Windows protected your PC”</b>, because the installer doesn’t carry a publisher’s signature yet. Press <b>More info</b>, then <b>Run anyway</b>.`,
  ] },
  { h: 'Sign in', p: [
    `Type the email of your ${NAME} account, then the code we send to it. New here? <a class="tlink" href="/signin">Sign up</a> on this website first: the software signs in to an account, it doesn’t make one.`,
  ] },
  { h: 'Your ARN', p: [
    `Your ARN as on your AMFI certificate. You tick one sentence allowing ${NAME} to sign in and act for you on CAMS and KFintech for this ARN.`,
  ] },
  { h: 'CAMS', p: [
    `The email registered with CAMS for this ARN. The software signs in to CAMS once to verify it, and reads the ARN CAMS shows: it must be the one you typed.`,
    `Nothing on CAMS? Choose “I don’t use CAMS”. You need at least one of CAMS and KFintech.`,
  ] },
  { h: 'KFintech', p: [
    `Your KFintech distributor login. The software signs in once to verify it, and you type the captcha it shows. The ARN KFintech shows must be yours too.`,
    `Nothing on KFintech? Choose “I don’t use KFintech”.`,
  ] },
  { h: 'Name and GSTIN', p: [
    `The software reads them from KFintech: your name and your GSTIN. Without KFintech, CAMS gives the name and you type the GSTIN.`,
    `It asks “Is this correct?”. Change anything that isn’t.`,
  ] },
  { h: 'Signature', p: [
    `A photo of your signature on plain paper. The software cleans it and shows it on a real invoice before you go on. Or use your USB signing token.`,
  ] },
  { h: 'Your books', p: [
    `Tally or Zoho Books, or neither. One per ARN. With TallyPrime and your company open on this PC, choose the company your invoices go into. With Zoho Books, sign in to your Zoho organisation.`,
    `It comes before Your invoices because your own invoice numbers continue from your books. You can skip it and connect your books later.`,
  ] },
  { h: 'Your invoices', p: [
    `Choose which invoice is uploaded: the registrar’s own, signed by you, or yours, in your own number series.`,
    `For your own, the numbers continue from your books. Without books, type your last invoice number exactly as printed.`,
  ] },
  { h: 'Mailbox', p: [
    `CAMS sends each month’s invoices by email. There are three ways to get it to the software, best first.`,
    `<b>Forward it to us.</b> A filter in your Gmail sends only CAMS’s mails on to an address of ours. Each one is locked so only your PC can open it, and deleted once your PC takes it.`,
    `<b>Gmail with an app password.</b> You make one in your Google account (16 letters, not your Gmail password) and type it once. It stays on your PC.`,
    `<b>By hand.</b> Each month the software asks CAMS for the email, and you add its two files yourself. This is also where it falls back if the others fail.`,
  ] },
  { h: 'Check everything', p: [
    `One screen with all of it. Finish, and press <b>Activate free trial</b>: ${TRIAL.days} days, nothing to pay.`,
    `From then on it is one button a month: Run.`,
  ] },
];
---
<Layout title={`Setup · ${NAME}`} description={`Setting up ${NAME}, step by step: about ten minutes, once.`} path="/setup" navOn="/setup">
<main>
  <section class="narrow">
    <div class="head"><h1 class="h2 rv">Setup</h1><p class="lede rv">About ten minutes, once. Have your ARN, your CAMS email and your KFintech login to hand.</p></div>
    <ol class="how">
      {STEPS.map((s, i) => <li class="rv">
        <span class="n">{i + 1}</span>
        <div><h2>{s.h}</h2>{s.p.map(p => <p set:html={p} />)}</div>
      </li>)}
    </ol>
    <p class="after rv">Stuck? <a class="tlink" href="/support">Write to us</a>, or see the <a class="tlink" href="/faq">questions</a>.</p>
  </section>
</main>
</Layout>

<style is:global>
.how{list-style:none;margin:0;padding:0 0 30px}
.how li{display:grid;grid-template-columns:44px minmax(0,1fr);gap:20px;padding:28px 0;border-top:1px solid var(--line)}
.how .n{width:36px;height:36px;border-radius:99px;background:var(--blue-wash);color:var(--blue);font-weight:600;font-size:15px;display:inline-flex;align-items:center;justify-content:center}
.how h2{margin:4px 0 8px;font-size:20px;font-weight:600;letter-spacing:-.02em}
.how p{margin:0 0 8px;font-size:15.5px;line-height:1.6;color:var(--ink-2)}
.after{padding:6px 0 110px;color:var(--muted)}
</style>
