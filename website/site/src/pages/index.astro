---
import Layout from '../layouts/Layout.astro';
import Brush from '../components/Brush.astro';
import Invoice from '../components/Invoice.astro';
import Signature from '../components/Signature.astro';
import Cta from '../components/Cta.astro';
import { NAME, SITE_URL, PRICE, EMAIL, BUSINESS } from '../consts';
import { invoice } from '../lib/sample';

const description = 'Give your time to clients, not to invoices. Your invoices on CAMS and KFintech, signed, submitted and imported into your bookkeeping software automatically.';
const schema = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: NAME, legalName: BUSINESS.legalName, url: SITE_URL, email: EMAIL.hello },
  {
    '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: NAME, description,
    operatingSystem: 'Windows 11', applicationCategory: 'BusinessApplication',
    offers: { '@type': 'Offer', price: PRICE.first, priceCurrency: 'INR', url: new URL('/pricing', SITE_URL).href },
  },
];
/* what it replaces: each way of doing it today, then us (the last one). Desktop reads it as a table, a phone as cards. */
const WAYS = ['Doing it yourself', 'A staff member', 'Your CA', NAME];
const ROWS: { q: string; a: string[]; best?: boolean }[] = [
  { q: 'Your time each month', a: ['2–4 hours', 'Checking their work', 'Chasing them', 'One click'] },
  { q: 'Cost', a: ['Your hours', 'A share of a salary', 'Fees every month', 'One yearly plan'] },
  { q: 'Rejected invoices followed up', a: ['If you remember', 'If they notice', 'If you tell them', 'Every time'] },
  { q: 'Works at 11pm before the deadline', a: ["If you're awake", "If they're in", 'If they pick up', 'Yes'], best: true },
];
const us = (i: number) => i === WAYS.length - 1;
/* the app's icons, as the demo draws them */
const lock = '<svg class="ic" viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>';
---
<Layout title={`${NAME} · GST commission invoices, done for you`} description={description} path="/" home reveal={0.15} schema={schema}>
<main id="top" class="home">
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1>Give your time to clients, <span>not to invoices.</span></h1>
        <p class="sub">Set it up once and get your full commission, GST included, always on time<span class="ast" tabindex="0" aria-describedby="astTip">*<span class="ast-tip" id="astTip" role="tooltip">It doesn’t run by itself. Once a month, you open the app and press one button.</span></span>. Your invoices on CAMS and KFintech, signed, submitted and imported into your bookkeeping software automatically.</p>
        <div class="ctas"><a class="btn secondary lg" href="/downloads">Downloads</a><Cta buy="/pricing" /></div>
        <div class="micro">
          <span><svg><use href="#tk"/></svg>CAMS and KFintech</span>
          <span><svg><use href="#tk"/></svg>Tally, and Zoho Books soon</span>
          <span><svg><use href="#tk"/></svg>Passwords stay with you</span>
        </div>
      </div>
      <div class="stage" id="stage" aria-hidden="true">
        <div class="stage-in" id="stageIn">
          <Invoice inv={invoice('ICICI Prudential')} style="left:40px;top:92px;--r:-8deg;--d:150ms" />
          <Invoice inv={invoice('SBI')} style="left:176px;top:14px;--r:6deg;--d:260ms" />
          <Invoice inv={invoice('HDFC')} class="p-front" style="left:112px;top:52px;--r:-1.5deg;--d:380ms" />
        </div>
      </div>
    </div>
  </section>

  <!-- THE MONTH TODAY -->
  <section class="sec line" id="today">
    <div class="wrap">
      <h2 class="h2 rv">The same three hours, <span class="g">every month.</span></h2>
      <div class="diary">
        <div class="clock" aria-hidden="true">
          <div class="day" id="cDay">Day 1 of the payout window</div>
          <span class="time" id="cTime">10:02</span>
          <div class="bar"><i id="cBar"></i></div>
          <div class="spent">Time spent <b id="cSpent">0m</b></div>
        </div>
        <div class="entries" id="entries">
          <div class="e" data-t="10:02" data-m="0"><span class="t">Day 1 · 10:02</span><p>Log in to CAMS. Ask for this month's invoices.</p></div>
          <div class="e" data-t="10:14" data-m="12"><span class="t">10:14</span><p>They come by email. Find it, download, unzip.</p><small>Eleven PDFs, one per fund house.</small></div>
          <div class="e" data-t="10:25" data-m="23"><span class="t">10:25</span><p>Open each one. Sign it. Save it.</p><small>Eleven times.</small></div>
          <div class="e" data-t="11:05" data-m="63"><span class="t">11:05</span><p>Fill the upload Excel, one row per fund house.</p></div>
          <div class="e" data-t="11:30" data-m="88"><span class="t">11:30</span><p>Upload. Check every figure on the screen.</p></div>
          <div class="e" data-t="12:00" data-m="118"><span class="t">12:00</span><p>Now KFintech. Log in, type the captcha.</p><small>It calls this month August. CAMS calls it September. Same money.</small></div>
          <div class="e" data-t="12:35" data-m="153"><span class="t">12:35</span><p>Six more invoices. Sign, upload, tick the declarations.</p></div>
          <div class="e" data-t="12:50" data-m="168"><span class="t">12:50</span><p>Open Tally. Type all seventeen again.</p><small>The same numbers, a third time.</small></div>
          <div class="e" data-t="13:02" data-m="180"><span class="t">13:02</span><p>Done, until next month.</p></div>
          <div class="e" data-t="Day 12" data-m="180" data-day="Eleven days later"><span class="t">Day 12</span><p>Log back in to both. Approved yet?</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ONE BUTTON -->
  <section class="sec white" id="how">
    <div class="wrap center">
      <h2 class="h2 rv">Now it's <Brush>one button.</Brush></h2>
      <p class="lede rv">Press Run October. It does all of that, then shows you one screen. Nothing is sent until you say yes.</p>

      <div class="win rv" id="appwin">
        <div class="win-bar">
          <span class="mark"><svg viewBox="0 0 24 24"><use href="#tk"/></svg></span>{NAME}
          <div class="win-ctl">
            <i><svg width="10" height="10" viewBox="0 0 10 10"><path d="M1 5h8" stroke="currentColor"/></svg></i>
            <i><svg width="10" height="10" viewBox="0 0 10 10"><rect x="1" y="1" width="8" height="8" fill="none" stroke="currentColor"/></svg></i>
            <i><svg width="10" height="10" viewBox="0 0 10 10"><path d="M1 1l8 8M9 1L1 9" stroke="currentColor"/></svg></i>
          </div>
        </div>
        <div class="app">
          <aside class="side">
            <div class="who"><span class="av">RK</span><div><b>R K Mehta</b><span>ARN-123456</span></div></div>
            <a class="on"><svg class="ic" viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>Overview</a>
            <a><svg class="ic" viewBox="0 0 24 24"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h5"/></svg>Invoices</a>
            <a><svg class="ic" viewBox="0 0 24 24"><path d="M5 4.5A1.5 1.5 0 0 1 6.5 3H19v15H6.5A1.5 1.5 0 0 0 5 19.5z"/><path d="M5 19.5A1.5 1.5 0 0 0 6.5 21H19"/></svg>Tally</a>
            <a><svg class="ic" viewBox="0 0 24 24"><path d="M4 7h9M17 7h3M4 17h3M11 17h9"/><circle cx="15" cy="7" r="2"/><circle cx="9" cy="17" r="2"/></svg>Settings</a>
            <div class="side-foot"><span>6 days to the 15th</span><span><i class="dot"></i>Ready</span></div>
          </aside>
          <div class="main">
            <div class="ov-h">
              <h4>October 2026</h4>
              <div class="stepper"><i><svg class="ic" width="14" height="14" viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6"/></svg></i><i><svg class="ic" width="14" height="14" viewBox="0 0 24 24"><path d="M9 6l6 6-6 6"/></svg></i></div>
              <span class="chk" id="chk"></span>
            </div>
            <div id="banner"></div>
            <div class="card month">
              <div><div class="n" id="mN"></div><div class="t" id="mT"></div></div>
              <div class="go" id="mGo"></div>
            </div>
            <div class="regs" id="regs"></div>
          </div>
        </div>
      </div>
      <div class="under">
        <span id="hint">This is the app. Press Run October.</span>
      </div>

      <div class="promises">
        <div class="rv"><b><span class="tick"><svg><use href="#tk"/></svg></span>Always crosschecks with live status.</b><p>It sees what CAMS and KFintech already have, so nothing is sent twice.</p></div>
        <div class="rv"><b><span class="tick"><svg><use href="#tk"/></svg></span>Matches every figure.</b><p>Each invoice is checked against the portal's own numbers. If anything differs, it stops and shows you.</p></div>
        <div class="rv"><b><span class="tick"><svg><use href="#tk"/></svg></span>Nothing goes unapproved.</b><p>One screen with every fund house and the total. It submits only after your yes.</p></div>
      </div>
    </div>
  </section>

  <!-- COMPARE -->
  <section class="sec" id="value">
    <div class="wrap">
      <h2 class="h2 rv">Here's what it replaces.</h2>
      <div class="cmp-wrap rv">
        <div class="cmp">
          <div class="bg"></div>
          <div class="hd"></div>{WAYS.map((w, i) => us(i)
            ? <div class="hd us"><span class="mark"><svg viewBox="0 0 24 24"><use href="#tk"/></svg></span>{w}</div>
            : <div class="hd">{w}</div>)}
          {ROWS.map(r => <>
            <div class:list={['rl', { best: r.best }]}>{r.q}</div>
            {WAYS.map((_, i) => <div class:list={[{ us: us(i), best: r.best }]}>{r.a[i]}</div>)}
          </>)}
        </div>
      </div>
      <div class="ways">{WAYS.map((w, i) => <div class:list={['way rv', { us: us(i) }]}>
        <h3>{us(i) && <span class="mark"><svg viewBox="0 0 24 24"><use href="#tk"/></svg></span>}{w}</h3>
        <dl>{ROWS.map(r => <div><dt>{r.q}</dt><dd>{r.a[i]}</dd></div>)}</dl>
      </div>)}</div>
      <p class="kicker rv">If it saves you one evening a month, it has paid for itself by March.</p>
    </div>
  </section>

  <!-- PRIVACY -->
  <section class="sec white line" id="privacy">
    <div class="wrap">
      <h2 class="h2 one rv">Your passwords stay safe <span class="g">with you.</span></h2>
      <p class="lede rv">So do your signature, your mailbox and your invoice files.</p>

      <div class="priv rv">
        <div class="box pc">
          <div class="box-h"><svg class="ic" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>Your PC</div>
          <div class="box-r"><Fragment set:html={lock} />KFintech password<span class="v">••••••••••</span></div>
          <div class="box-r"><Fragment set:html={lock} />Mailbox <span class="rt">Read-only</span><span class="v">•••• •••• ••••</span></div>
          <div class="box-r"><svg class="ic" viewBox="0 0 24 24"><path d="M4 20l4-1 11-11-3-3L5 16z"/></svg>Your signature<span class="v"><Signature class="sig" /></span></div>
          <div class="box-r"><svg class="ic" viewBox="0 0 24 24"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6"/></svg>Every invoice, every month<span class="v">Oct 2026 · 17 PDFs</span></div>
        </div>
        <div class="link" aria-hidden="true"><span><Fragment set:html={lock} /></span></div>
        <div class="box ours">
          <div class="box-h"><svg class="ic" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><path d="M7 7.5h.01M7 16.5h.01"/></svg>Our side</div>
          <div class="box-r">CAMS<span class="st"><i></i>Working</span></div>
          <div class="box-r">KFintech<span class="st"><i style="animation-delay:1.3s"></i>Working</span></div>
          <div class="box-r">Your account<span class="v">Yearly plan</span></div>
          <div class="never">Never sees <span class="x" style="--i:0">passwords</span> · <span class="x" style="--i:1">signature</span> · <span class="x" style="--i:2">mailbox</span> · <span class="x" style="--i:3">invoice files</span></div>
        </div>
        <p class="cap capL">Before anything is sent to us, the software checks for any passwords in the data and removes them. <a class="more" href="/security">Learn more</a></p>
        <p class="cap capR">When CAMS or KFintech change their workflow, we adapt fast so our service stays reliable at all times. Especially during the peak hours!</p>
      </div>
    </div>
  </section>

  <!-- FINAL -->
  <section class="final">
    <div class="wrap">
      <h2 class="h2 rv">Spare 10 minutes for setup, and you won't need any portals again.</h2>
      <div class="ctas rv"><Cta buy="/pricing" /></div>
    </div>
  </section>
</main>
</Layout>

<style is:global>
/* the home page's headings are bigger than the other pages' (base.css) */
.home .h2{font-size:clamp(34px,4.4vw,58px);line-height:1.04;letter-spacing:-.042em;max-width:16ch}
.home .brush{margin:0 0 0 .14em;padding:0 .4em 0 .1em}
.home .brush svg{top:-.15em;height:1.34em}
.home .lede{margin-top:22px}
.ic{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}

/* ---------- hero ---------- */
.hero{position:relative;padding:56px 0 120px;overflow:hidden}
.hero::before{content:"";position:absolute;inset:0;background-image:radial-gradient(#d8dde5 1px,transparent 1.2px);background-size:24px 24px;-webkit-mask-image:radial-gradient(ellipse 60% 70% at 72% 45%,#000 20%,transparent 75%);mask-image:radial-gradient(ellipse 60% 70% at 72% 45%,#000 20%,transparent 75%);pointer-events:none}
.hero-grid{position:relative;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:48px;align-items:center;min-height:min(760px,calc(100vh - 90px))}
.hero h1{font-size:clamp(44px,5.8vw,80px);line-height:1;letter-spacing:-.048em;font-weight:560}
.hero h1 span{color:var(--faint)}
.hero .sub{margin-top:28px;font-size:19px;line-height:1.55;color:var(--ink-2);max-width:30em}
.ast{position:relative;display:inline-block;margin-left:1px;color:var(--blue);font-weight:600;cursor:help;outline:none}
.ast-tip{position:absolute;left:50%;bottom:calc(100% + 10px);width:260px;padding:10px 12px;border-radius:8px;background:var(--ink);color:#fff;font-size:13px;font-weight:400;line-height:1.45;box-shadow:var(--e-sheet);opacity:0;transform:translate(-50%,4px);pointer-events:none;transition:opacity 160ms var(--ease),transform 160ms var(--ease);z-index:5}
.ast-tip::after{content:"";position:absolute;left:50%;top:100%;margin-left:-6px;border:6px solid transparent;border-top-color:var(--ink)}
.ast:hover .ast-tip,.ast:focus .ast-tip{opacity:1;transform:translate(-50%,0)}
.ctas{display:flex;gap:10px;flex-wrap:wrap;margin-top:36px}
.micro{display:flex;flex-wrap:wrap;gap:8px 20px;margin-top:22px;font-size:13.5px;color:var(--muted)}
.micro span{display:inline-flex;align-items:center;gap:7px}
.micro svg{width:13px;height:13px;color:var(--green)}
.hero-copy > *{animation:rise 600ms var(--ease) both}
.hero-copy > :nth-child(2){animation-delay:80ms}
.hero-copy > :nth-child(3){animation-delay:160ms}
.hero-copy > :nth-child(4){animation-delay:220ms}
@media (max-width:980px){
  .hero{padding:40px 0 72px}
  .hero-grid{grid-template-columns:minmax(0,1fr);min-height:0;gap:56px}
}
/* the stack of invoices (Invoice.astro): they rise in, the front one signs itself and is stamped */
.stage{position:relative;width:100%;justify-self:end;max-width:560px}
.stage-in{position:relative;width:560px;height:620px;transform-origin:0 0}
.stage .paper{width:372px;opacity:0;transform:translateY(28px) rotate(var(--r));animation:paperIn 800ms var(--ease) forwards;animation-delay:var(--d)}
@keyframes paperIn{to{opacity:1;transform:translateY(0) rotate(var(--r))}}
.p-front .sig path{stroke-dasharray:1;stroke-dashoffset:1;animation:draw 1300ms cubic-bezier(.55,.1,.35,1) forwards;animation-delay:1100ms}
.p-front .sig path + path{animation-duration:500ms;animation-delay:2300ms}
.paper:not(.p-front) .stamp{display:none}
.p-front .stamp{opacity:0;animation:stamp 440ms cubic-bezier(.2,1.4,.4,1) forwards;animation-delay:2850ms}

/* ---------- sections ---------- */
.sec{padding:140px 0}
.sec.white{background:var(--surface)}
.sec.line{border-top:1px solid var(--line)}
.center{text-align:center}
.center .h2,.center .lede{margin-left:auto;margin-right:auto}
@media (max-width:720px){
  .sec{padding:88px 0}
}

/* ---------- the diary: the clock follows the entry in the middle of the screen ---------- */
.diary{display:grid;grid-template-columns:5fr 7fr;gap:72px;margin-top:40px}
.clock{position:sticky;top:34vh;align-self:start}
.clock .day{font-size:14px;font-weight:500;color:var(--muted)}
.clock .time{display:block;margin-top:6px;font-family:var(--mono);font-size:clamp(72px,9vw,132px);line-height:1;letter-spacing:-.07em;font-weight:500}
.clock .time.flip{animation:flip 280ms var(--ease)}
@keyframes flip{from{opacity:.2;transform:translateY(8px)}}
.clock .bar{max-width:380px;height:4px;margin-top:32px;background:var(--line);border-radius:4px;overflow:hidden}
.clock .bar i{display:block;height:100%;width:0;background:var(--ink);border-radius:4px;transition:width 600ms var(--ease)}
.clock .spent{margin-top:12px;font-size:14px;color:var(--muted)}
.clock .spent b{font-family:var(--mono);font-weight:500;color:var(--ink)}
.entries{padding:14vh 0 22vh}
.e{min-height:36vh;display:flex;flex-direction:column;justify-content:center}
.e .t{display:none;font-family:var(--mono);font-size:13px;color:var(--muted);margin-bottom:6px}
.e p{font-size:clamp(24px,2.7vw,36px);line-height:1.2;letter-spacing:-.03em;font-weight:500;color:var(--ghost);transition:color 320ms var(--ease)}
.e small{display:block;margin-top:12px;font-size:17px;color:var(--muted);opacity:0;transform:translateY(6px);transition:opacity 320ms var(--ease),transform 320ms var(--ease)}
.e.on p{color:var(--ink)}
.e.on small{opacity:1;transform:none}
@media (max-width:880px){
  .diary{grid-template-columns:1fr;gap:0;margin-top:40px}
  .clock{display:none}
  .entries{padding:0}
  .e{min-height:0;padding:22px 0;border-top:1px solid var(--line)}
  .e .t{display:block}
  .e p{color:var(--ink)}
  .e small{opacity:1;transform:none;font-size:15.5px}
  .e{opacity:0;transform:translateY(12px);transition:opacity 500ms var(--ease),transform 500ms var(--ease)}
  .e.seen{opacity:1;transform:none}
}

/* ---------- the app window: a real run, cut short ---------- */
.win{position:relative;margin-top:64px;background:var(--surface);border:1px solid var(--line);border-radius:var(--r-sheet);box-shadow:var(--e-sheet);overflow:hidden;font-size:14px;line-height:1.55;text-align:left}
.win-bar{height:36px;display:flex;align-items:center;gap:8px;padding-left:12px;border-bottom:1px solid var(--line-2);background:var(--subtle);font-size:12.5px;font-weight:500;color:var(--ink-2)}
.win-bar .mark{width:16px;height:16px;border-radius:5px}
.win-bar .mark svg{width:10px;height:10px}
.win-ctl{margin-left:auto;display:flex}
.win-ctl i{width:44px;height:36px;display:grid;place-items:center;color:var(--muted)}
.win .spin{width:18px;height:18px;border:2px solid var(--blue-line);border-top-color:var(--blue);flex-shrink:0}
.app{display:grid;grid-template-columns:212px 1fr;height:480px}
.side{border-right:1px solid var(--line);background:var(--subtle);padding:14px 10px;display:flex;flex-direction:column;gap:2px}
.who{display:flex;align-items:center;gap:10px;padding:8px 10px 14px;margin-bottom:6px;border-bottom:1px solid var(--line-2)}
.who .av{width:28px;height:28px;border-radius:8px;background:var(--blue-wash);color:var(--blue);display:grid;place-items:center;font-size:11.5px;font-weight:600}
.who b{display:block;font-size:13px;font-weight:600;line-height:1.2}
.who span{font-size:11.5px;color:var(--muted);font-family:var(--mono)}
.side a{display:flex;align-items:center;gap:10px;height:36px;padding:0 10px;border-radius:8px;font-size:13.5px;font-weight:500;color:var(--ink-2)}
.side a.on{background:var(--surface);color:var(--ink);box-shadow:var(--e-card),inset 0 0 0 1px var(--line)}
.side a .ic{width:17px;height:17px;color:var(--muted)}
.side a.on .ic{color:var(--blue)}
.side-foot{margin-top:auto;padding:10px;font-size:12px;color:var(--muted);display:flex;flex-direction:column;gap:6px}
.side-foot span{display:flex;align-items:center;gap:7px}
.side-foot .dot{width:7px;height:7px;border-radius:9px;background:var(--green)}
.main{padding:28px 32px;overflow:hidden}
.ov-h{display:flex;align-items:center;gap:10px}
.ov-h h4{font-size:21px;font-weight:600;letter-spacing:-.02em}
.stepper{display:flex;gap:2px;margin-left:4px}
.stepper i{width:26px;height:26px;border-radius:6px;display:grid;place-items:center;color:var(--muted)}
.ov-h .chk{margin-left:auto;font-size:12.5px;color:var(--muted);display:inline-flex;align-items:center;gap:6px}
.ov-h .chk button{border:0;background:none;padding:2px 4px;margin:-2px -4px;border-radius:5px;color:var(--blue);font-size:12.5px;font-weight:500}
.ov-h .chk button:hover{text-decoration:underline}
.ov-h .chk button.nudge{animation:nudge 2.2s var(--ease) infinite}
@keyframes nudge{0%,100%{background:transparent}50%{background:var(--blue-wash)}}
.ov-h .chk .spin{width:12px;height:12px;border-width:1.5px}
