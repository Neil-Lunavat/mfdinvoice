</style>
<script>
import { INVOICES, sum, rs } from '../lib/sample';
import { $, tick } from '../scripts/client';

const total = sum(INVOICES), cams = INVOICES.filter(x => x.reg === 'CAMS'), kf = INVOICES.filter(x => x.reg === 'KFintech');

/* ---- hero: the stack of invoices scales down to fit ---- */
function fit() {
  const w = $('stage').clientWidth, s = Math.min(1, w / 560);
  $('stageIn').style.transform = `scale(${s})`;
  $('stage').style.height = 620 * s + 'px';
}
fit();
addEventListener('resize', fit);

/* ---- the diary: the clock follows the entry in the middle of the screen ---- */
const ents = [...document.querySelectorAll<HTMLElement>('.e')];
let cur: HTMLElement | null = null;
function setEntry(e: HTMLElement) {
  if (e === cur) return;
  cur = e;
  ents.forEach(x => x.classList.toggle('on', x === e));
  const m = +e.dataset.m!;
  const t = $('cTime');
  t.textContent = e.dataset.t;
  t.classList.remove('flip'); void t.offsetWidth; t.classList.add('flip');
  $('cDay').textContent = e.dataset.day || 'Day 1 of the payout window';
  $('cSpent').textContent = m >= 60 ? `${Math.floor(m / 60)}h ${String(m % 60).padStart(2, '0')}m` : `${m}m`;
  $('cBar').style.width = (m / 180) * 100 + '%';
}
const dio = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) setEntry(e.target as HTMLElement); }), { rootMargin: '-48% 0px -48% 0px' });
ents.forEach(e => dio.observe(e));
/* on a phone the clock is hidden: each entry fades in as it passes 40% from the bottom of the screen, and stays */
const seen = new IntersectionObserver(es => es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('seen'); seen.unobserve(e.target); } }), { rootMargin: '0px 0px -40% 0px' });
ents.forEach(e => seen.observe(e));
setEntry(ents[0]);

/* ---- the app: a real run, cut short ---- */
const steps = [
  ["Checking what's already submitted", 'Nothing yet for October'],
  ['Getting the invoices', '11 from CAMS · 6 from KFintech'],
  ['Reading every figure', 'As each registrar calculated it'],
  ['Signing', 'Your signature on all 17'],
  ['Preparing both uploads', 'Ready for CAMS and KFintech'],
  ['Double-checking', 'All 17 match, to the paisa'],
];
type State = 'ready' | 'sent' | 'checked' | 'fixed' | 'done';
let state: State = 'ready';
let checkedAt = 'today 09:12';
const warn = '<svg class="ic" viewBox="0 0 24 24"><path d="M12 3l9.5 17h-19z"/><path d="M12 10v4M12 17h.01"/></svg>';
function regCard(name: string, list: typeof INVOICES, filled: number, chip: string, bad = false) {
  return `<div class="card reg"><div class="k">${name}<svg class="ic" viewBox="0 0 24 24"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg></div>
    <div class="c">${list.length} invoices${chip}</div><div class="a">${rs(sum(list))} with GST</div>
    <div class="dots">${[0, 1, 2, 3].map(i => `<i class="${i < filled ? 'f' : i === 3 && bad ? 'r' : ''}"></i>`).join('')}</div>
    <div class="dots-l"><span>Get</span><span>Sign</span><span>Submit</span><span>Approved</span></div></div>`;
}
function overview() {
  const n = INVOICES.length;
  const view = {
    ready: [`${n} invoices to do`, `${rs(total)} with GST · due 15 October`, ''],
    sent: [`${n} invoices submitted`, `0 of ${n} approved so far`, `<span class="chip wait">${n} waiting</span>`],
    checked: [`15 of ${n} approved`, '1 waiting · 1 rejected', '<span class="chip bad">1 rejected</span>'],
    fixed: [`15 of ${n} approved`, '2 waiting', '<span class="chip wait">2 waiting</span>'],
    done: [`All ${n} approved`, `${rs(total)} with GST · October is done`, '<span class="chip ok">Approved</span>'],
  }[state];
  $('mN').textContent = view[0];
  $('mT').textContent = view[1];
  $('mGo').innerHTML = state === 'ready'
    ? '<button class="btn run call" type="button" id="runBtn">Run October</button><span>About 5 min</span>'
    : view[2];
  const camsChip = ({ checked: ' <span class="chip wait">1 waiting</span>', fixed: ' <span class="chip wait">1 waiting</span>' } as Record<string, string>)[state] || '';
  const kfChip = ({ checked: ' <span class="chip bad">1 rejected</span>', fixed: ' <span class="chip wait">1 waiting</span>' } as Record<string, string>)[state] || '';
  const fill = { ready: 0, sent: 3, checked: 3, fixed: 3, done: 4 }[state];
  $('regs').innerHTML = regCard('CAMS', cams, fill, camsChip) + regCard('KFintech', kf, fill, kfChip, state === 'checked');
  $('banner').innerHTML = state === 'checked'
    ? `<div class="banner">${warn}<div><b>Axis rejected an invoice.</b><p>KFintech says: “Signature not clear. Please upload again.”</p></div><button class="btn primary sm" type="button" id="fixBtn">Send again</button></div>`
    : '';
  if (state === 'checked') $('fixBtn').onclick = fix;
  const nudge = state === 'sent' || state === 'fixed';
  $('chk').innerHTML = `<span class="when">Checked ${checkedAt} · </span><button type="button" id="chkBtn" class="${nudge ? 'nudge' : ''}">Check now</button>`;
  $('chkBtn').onclick = checkNow;
  if (state === 'ready') $('runBtn').onclick = run;
  $('hint').innerHTML = {
    ready: 'This is the app. Press Run October.',
    sent: 'Submitted. Now press Check now, at the top.',
    checked: 'One came back rejected. Send it again.',
    fixed: 'Sent again. Press Check now.',
    done: 'That\'s October, done. <button type="button" id="again">Run it again</button>',
  }[state];
  if (state === 'done') $('again').onclick = () => { state = 'ready'; checkedAt = 'today 09:12'; overview(); };
}
function checkNow() {
  $('chk').innerHTML = '<span class="spin"></span>Checking<span class="when"> for approvals</span>';
  setTimeout(() => {
    state = ({ sent: 'checked', fixed: 'done' } as Record<string, State>)[state] || state;
    checkedAt = 'just now';
    overview();
  }, 1300);
}
function overlay(html: string) {
  const ov = document.createElement('div');
  ov.className = 'runov'; ov.id = 'runov';
  ov.innerHTML = html;
  $('appwin').appendChild(ov);
}
function fix() {
  const axis = INVOICES[1];
  overlay(`<div class="rm" id="rm"><div class="rm-h"><div class="m">Send again</div><h5>Axis · ${rs(axis.total)}</h5></div>
    <div class="rm-b" style="min-height:0"><div class="bq">KFintech says: “Signature not clear. Please upload again.”</div></div>
    <div class="ck-f"><span style="font-size:13px;color:var(--muted)">Not sure what to do? <a style="color:var(--blue);font-weight:500">Send to support</a></span>
      <div class="b"><button class="btn ghost" type="button" id="fxNo">Cancel</button><button class="btn primary" type="button" id="fxGo">Submit 1 invoice</button></div></div></div>`);
  $('fxNo').onclick = close;
  $('fxGo').onclick = () => {
    $('rm').innerHTML = `<div class="done-v"><span class="stamp">SUBMITTED<small>KFINTECH · 2 OCT 2026</small></span>
      <div><b>Axis · ${rs(axis.total)}</b><p>We'll notify you once approved.</p></div>
      <button class="btn secondary" type="button" id="closeBtn">Close</button></div>`;
    state = 'fixed';
    $('closeBtn').onclick = close;
  };
}
function run() {
  overlay(`<div class="rm" id="rm"><div class="rm-h"><div class="m">October 2026</div><h5>Getting October ready</h5><div class="prog"><i id="pf"></i></div></div>
    <div class="rm-b"><div id="cur"></div><div class="log" id="log"></div></div></div>`);
  let i = 0;
  const next = (): any => {
    if (i === steps.length) { $('cur').innerHTML = ''; return setTimeout(check, 450); }
    $('cur').innerHTML = `<div class="cur"><span class="spin"></span>${steps[i][0]}</div>`;
    setTimeout(() => {
      $('log').insertAdjacentHTML('afterbegin', `<div class="lr">${tick('dt')}${steps[i][0]}<span>${steps[i][1]}</span></div>`);
      i++;
      $('pf').style.width = (i / steps.length) * 100 + '%';
      next();
    }, 820);
  };
  next();
}
function check() {
  const rm = $('rm');
  rm.classList.add('wide');
  rm.innerHTML = `<div class="rm-h"><div class="m">Your check</div><h5>Submit ${INVOICES.length} invoices for October 2026?</h5></div>
    <div class="ck-sc"><table class="inv"><thead><tr><th>AMC</th><th class="no">Invoice</th><th class="num">Total</th></tr></thead><tbody>
      ${INVOICES.map(x => `<tr><td>${x.amc}<span class="tag">${x.reg === 'CAMS' ? 'CAMS' : 'KFin'}</span></td><td class="no mono">${x.no}</td><td class="num">${rs(x.total)}</td></tr>`).join('')}
    </tbody></table></div>
    <div class="ck-tot"><span>${INVOICES.length} invoices</span><span>${rs(total)}</span></div>
    <div class="ck-f"><label class="check"><input type="checkbox" id="ok">I've checked these ${INVOICES.length} invoices and the total</label>
      <div class="b"><button class="btn ghost" type="button" id="notNow">Not now</button><button class="btn primary" type="button" id="sub" disabled>Submit ${INVOICES.length} invoices</button></div></div>`;
  $('ok').onchange = (e: any) => { $('sub').disabled = !e.target.checked; };
  $('notNow').onclick = close;
  $('sub').onclick = () => {
    rm.classList.remove('wide');
    rm.innerHTML = `<div class="done-v"><span class="stamp">SUBMITTED<small>CAMS · KFINTECH · 1 OCT 2026</small></span>
      <div><b>${INVOICES.length} invoices for October · ${rs(total)}</b><p>We'll notify you once approved.</p></div>
      <button class="btn secondary" type="button" id="closeBtn">Close</button></div>`;
    state = 'sent';
    $('closeBtn').onclick = close;
  };
}
function close() {
  const ov = $('runov');
  ov.classList.add('out');
  setTimeout(() => { ov.remove(); overview(); }, 200);
}
overview();
</script>
