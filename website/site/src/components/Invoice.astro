---
/* One sample commission invoice on paper, signed and stamped (lib/sample.ts). The home page's hero stack and
   Security's walk-through each place it and animate it. checks: a tick after each figure, for "every figure is checked". */
import Signature from './Signature.astro';
import { fm, type SampleInvoice } from '../lib/sample';
import '../styles/invoice.css';

interface Props { inv: SampleInvoice; checks?: boolean; class?: string; style?: string }
const { inv: x, checks = false, class: cls, style } = Astro.props;
const ok = checks ? '<svg class="ok" viewBox="0 0 24 24"><use href="#tk"/></svg>' : '';
const tax: [string, number][] = x.igst ? [['IGST 18%', x.igst]] : [['CGST 9%', x.half], ['SGST 9%', x.half]];
---
<div class:list={['paper', cls]} style={style}>
  <div class="pp-top">
    <div><div class="pp-title">Tax invoice</div><div class="pp-from">R K Mehta</div><div class="pp-id mono">ARN-123456 · GSTIN 27ABCPM1234F1Z3</div></div>
    <div class="pp-no"><span>Invoice</span><b class="mono">{x.no}</b><span>1 Oct 2026</span></div>
  </div>
  <div class="pp-to"><span>Bill to</span><b>{x.amc} Mutual Fund</b></div>
  <table class="pp-t">
    <tr><td>Brokerage, September 2026<small>SAC 997152</small></td><td>{fm(x.taxable)}<Fragment set:html={ok} /></td></tr>
    {tax.map(([label, amount]) => <tr><td>{label}</td><td>{fm(amount)}<Fragment set:html={ok} /></td></tr>)}
    <tr class="tot"><td>Total</td><td>₹{fm(x.total)}</td></tr>
  </table>
  <div class="pp-sign"><span>For R K Mehta</span><Signature class="sig" /><span class="line">Authorised signatory</span></div>
  <div class="stamp">SUBMITTED<small>{x.reg.toUpperCase()} · 1 OCT 2026</small></div>
</div>
