---
/* The site's main button. Someone who has never had a plan gets "Try for Free" (to Downloads: the trial starts in the
   app). Signed out, it goes through Sign in first, so Downloads doesn't greet them with "sign in". Once their account
   has had a plan, a trial included, it is "Buy now". Both are rendered and one shows: public/si.js puts
   <html class="si"> and <html class="hp"> from the cookies before the page paints, and the rule is in Layout's <head>. */
interface Props { buy: string }          /* where Buy now goes */
const { buy } = Astro.props;
---
<a class="btn primary lg cta-try" href="/signin?next=/downloads">Try for Free</a><a class="btn primary lg cta-buy" href={buy}>Buy now</a>

<script>
  /* signed in: straight to Downloads. Still on "Try": ask once whether the account has had a plan (/api/me sets the
     cookie), since a trial starts in the software, not in this browser. */
  import { me } from '../scripts/client';
  const html = document.documentElement.classList;
  if (html.contains('si')) {
    document.querySelectorAll<HTMLAnchorElement>('.cta-try').forEach(a => { a.href = '/downloads'; });
    if (!html.contains('hp')) me().then(m => html.toggle('hp', !!m.had_plan)).catch(() => {});
  }
</script>
