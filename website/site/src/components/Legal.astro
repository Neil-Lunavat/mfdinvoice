---
/* Terms, Privacy and Refunds: one layout. Each section is a heading and its paragraphs (HTML allowed: links, lists,
   and a company detail still in [brackets], greyed by lib/format.ts shown). The company's details and the prices come
   from consts.ts, so the three pages follow it. A draft until the lawyer has read it: the note says so. */
import { TERMS_VERSION } from '../consts';
import { longDate } from '../lib/date';
export type Section = { h: string; p: string[] };
interface Props { title: string; sections: Section[] }
const { title, sections } = Astro.props;
const id = (h: string) => h.toLowerCase().replace(/[’']/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
---
<main>
  <section class="page">
    <div class="head"><h1 class="h2">{title}</h1><p class="upd">Last updated: {longDate(TERMS_VERSION)}</p></div>
    <div class="legal-g">
      <nav class="ltoc">{sections.map(s => <a href={`#${id(s.h)}`}>{s.h}</a>)}</nav>
      <div class="doc">
        <p class="draft">A draft, until our lawyer has reviewed it.</p>
        {sections.map(s => <Fragment><h2 id={id(s.h)}>{s.h}</h2>{s.p.map(x => x.startsWith('<ul') ? <Fragment set:html={x} /> : <p set:html={x} />)}</Fragment>)}
      </div>
    </div>
  </section>
</main>

<style is:global>
.legal-g{display:grid;grid-template-columns:220px minmax(0,1fr);gap:64px;align-items:start;padding-bottom:110px}
.ltoc{position:sticky;top:110px;display:flex;flex-direction:column;gap:2px}
.ltoc a{padding:7px 12px;border-radius:8px;font-size:13.5px;color:var(--ink-2)}
.ltoc a:hover{background:var(--surface);box-shadow:var(--e-card)}
.doc h2{margin:40px 0 10px;font-size:20px;font-weight:600;letter-spacing:-.02em;scroll-margin-top:110px}
.doc h2:first-of-type{margin-top:0}
.doc p,.doc li{font-size:16px;line-height:1.7;color:var(--ink-2);max-width:66ch}
.doc p{margin:0 0 12px}
.doc ul{margin:0 0 12px;padding-left:22px}
.doc li{margin:0 0 6px}
.doc a{color:var(--blue)}
.doc a:hover{text-decoration:underline}
.doc b{color:var(--ink);font-weight:600}
.upd{margin-top:10px;font-size:14px;color:var(--muted)}
@media (max-width:860px){.legal-g{grid-template-columns:1fr;gap:24px}.ltoc{position:static}}
</style>
