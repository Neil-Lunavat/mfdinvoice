---
/* The blue brush stroke behind one phrase. It paints in when its .rv parent gets .in. */
---
<span class="brush"><slot /><svg viewBox="0 0 400 100" preserveAspectRatio="none" aria-hidden="true">
  <defs><filter id="brushEdge" x="-4%" y="-20%" width="108%" height="140%"><feTurbulence type="fractalNoise" baseFrequency="0.02 0.3" numOctaves="2" seed="7"/><feDisplacementMap in="SourceGraphic" scale="5"/></filter></defs>
  <g filter="url(#brushEdge)" fill="#1d4ed8">
    <path d="M16 23C82 13 192 9 292 12c40 1 68 4 84 8l8 13-6 13 8 13-9 13c-38 9-126 15-206 15-70 0-124-3-154-8-8-10-10-22-6-34-4-8-2-16 4-22z"/>
    <g fill="none" stroke="#1d4ed8" stroke-linecap="round">
      <path d="M356 21c14 0 28 2 40 5" stroke-width="5"/><path d="M360 39c14 0 26 1 38 3" stroke-width="4"/>
      <path d="M356 57c14 0 26 1 36 3" stroke-width="6"/><path d="M346 75c14-1 26-2 40-4" stroke-width="3.5"/>
      <path d="M36 93c90 5 214 3 322-5" stroke-width="2.5" opacity=".45"/>
    </g>
    <g fill="none" stroke="#fff" stroke-linecap="round" opacity=".09"><path d="M34 33c96-7 218-9 318-4" stroke-width="3"/><path d="M28 68c104 5 222 5 330-2" stroke-width="2"/></g>
