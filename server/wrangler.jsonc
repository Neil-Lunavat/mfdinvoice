{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The software's own server: https://software.mfdinvoice.co.in (and software.<your-subdomain>.workers.dev, which
  // keeps answering until every installed app has updated to one that asks the new name: client/src/client/brand.json)
  // It knows the software and nothing about accounts (that is the website, website/site). Three jobs:
  //   - the current portal steps, as static files under /automation (made by ops/automation.py, signed)
  //   - what the app sends to support: POST /report, and a run's record after it
  //   - reading those back, for whoever fixes things: /admin/*, with the key
  "name": "software",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-01",
  // /automation/latest.json and /automation/<version>.zip are served straight from here; the Worker never sees them
  "assets": { "directory": "./public" },
  // what was sent to support. The id is written here by `bun run first`
  "d1_databases": [
    { "binding": "DB", "database_name": "software-db", "database_id": "6bce22cb-365e-4e16-99be-824a856cc08b" }
  ],
  // each run's record (pictures of the invoice pages, a page's HTML), one zip per report
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "software-files" }
  ],
  "workers_dev": true,
  "routes": [{ "pattern": "software.mfdinvoice.co.in", "custom_domain": true }],
  // Daily at 03:00 IST (21:30 UTC): reports older than 90 days are deleted, with their records (src/index.ts forget)
  "triggers": { "crons": ["30 21 * * *"] },
  // the code that proves a CAMS email is the person's, for forwarding (src/forward.ts), from no-reply@mfdinvoice.co.in
  "send_email": [{ "name": "EMAIL" }],
  // Secret (set by `bun run first`): ADMIN_KEY, for /admin/*
  "observability": { "enabled": true }
}
